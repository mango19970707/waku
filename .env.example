# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=waku
DB_SSLMODE=disable
DB_LOG_LEVEL=info

# 应用配置
APP_PORT=6060
APP_ENV=development

# AI 模型配置 - OpenAI
MODEL_PROVIDER=openai
MODEL_API_KEY=your_openai_api_key
MODEL_BASE_URL=
MODEL_NAME=gpt-4
MODEL_TIMEOUT=60s
MODEL_MAX_TOKENS=2000
MODEL_TEMPERATURE=0.7

# AI 模型配置 - Azure OpenAI (如果使用 Azure)
# MODEL_PROVIDER=azure_openai
# MODEL_API_KEY=your_azure_api_key
# MODEL_BASE_URL=https://your-resource.openai.azure.com
# MODEL_NAME=gpt-4
# MODEL_API_VERSION=2024-02-15-preview
# MODEL_TIMEOUT=60s
# MODEL_MAX_TOKENS=2000
# MODEL_TEMPERATURE=0.7

# AI 模型配置 - Ollama (如果使用本地 Ollama)
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://localhost:11434
# MODEL_NAME=llama3
# MODEL_TIMEOUT=60s

# AI 模型配置 - Anthropic Claude (如果使用 Claude)
# MODEL_PROVIDER=anthropic
# MODEL_API_KEY=your_anthropic_api_key
# MODEL_BASE_URL=
# MODEL_NAME=claude-3-5-sonnet-20241022
# MODEL_TIMEOUT=60s
# MODEL_MAX_TOKENS=2000
# MODEL_TEMPERATURE=0.7

# AI 模型配置 - Ark (如果使用字节跳动 Ark)
# MODEL_PROVIDER=ark
# MODEL_API_KEY=your_ark_api_key
# MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_NAME=your_model_endpoint_id
# MODEL_TIMEOUT=60s
# MODEL_MAX_TOKENS=2000
# MODEL_TEMPERATURE=0.7
