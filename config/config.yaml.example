# 数据库配置
database:
  host: localhost
  port: 5432
  user: postgres
  password: your_password
  dbname: waku
  sslmode: disable
  log_level: info  # silent, error, warn, info

# 应用配置
app:
  port: 8080
  env: development  # development, production

# AI 模型配置
model:
  provider: openai  # openai, azure_openai, ollama, ark, anthropic
  api_key: your_api_key
  base_url: ""  # 可选，自定义 API 地址
  model: gpt-4  # 模型名称
  timeout: 60s  # 请求超时时间
  api_version: ""  # Azure OpenAI 需要
  max_tokens: 2000  # 最大生成 token 数
  temperature: 0.7  # 温度参数 (0.0-1.0)
  custom_headers:  # 可选，自定义请求头
    # X-Custom-Header: value
